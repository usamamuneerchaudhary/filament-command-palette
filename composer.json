{
    "name": "usamamuneerchaudhary/filament-command-palette",
    "description": "A Spotlight/CMD+K style command palette for Filament: fuzzy search across navigation, records and actions.",
    "keywords": ["usamamuneerchaudhary", "laravel", "filament", "command-palette", "cmdk", "spotlight", "php", "filamentphp"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Usama Muneer",
            "email": "hello@usamamuneer.me",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Usamamuneerchaudhary\\CommandPalette\\": "src"
        }
    },
    "require": {
        "php": "^8.2",
        "spatie/laravel-package-tools": "^1.19",
        "filament/filament": "^4.0|^5.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Usamamuneerchaudhary\\CommandPalette\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.17",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-text",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Usamamuneerchaudhary\\CommandPalette\\CommandPaletteServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
