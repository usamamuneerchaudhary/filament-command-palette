includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - src
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Filament's static resource/page APIs vary between v4 and v5; every
        # call site here is guarded with method_exists() at runtime.
        - '#Call to an undefined static method#'
