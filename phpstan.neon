includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - src
    # Match composer.json's php ^8.2 so CI (PHP 8.5) and local do not drift.
    phpVersion: 80200
    treatPhpDocTypesAsCertain: false
    # Fail loudly if Larastan learns about package view namespaces.
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        # make()/for() return static so subclasses keep working.
        -
            identifier: new.static
            path: src
        # method_exists() guards Filament v4, which PHPStan on v5 treats as tautology.
        -
            identifier: function.alreadyNarrowedType
            path: src/Support/Providers
        # generate_icon_html() is Htmlable on Filament v5 and string|null on v4.
        -
            identifier: instanceof.alwaysTrue
            path: src/Livewire/CommandPalette.php
        # Policy helpers can throw at runtime; PHPStan only sees the bool return.
        -
            identifier: catch.neverThrown
            path: src/Support/Providers/ResourceCommandProvider.php
        # Larastan resolves view names against a finder it builds itself, which
        # cannot learn the `command-palette::` namespace registered at runtime
        # via hasViews()/loadViewsFrom().
        -
            message: '#^Parameter \#1 \$view of function view expects view-string\|null, string given\.$#'
            identifier: argument.type
            path: src
